{
  "name": "earth-news",
  "private": true,
  "version": "0.1.0",
  "description": "Explore world news, AI and technology on an interactive globe. Local-first, Chinese reading briefs, no-key demo.",
  "license": "MIT",
  "author": "cyxhrh",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cyxhrh/earth-now.git"
  },
  "type": "module",
  "scripts": {
    "demo": "node scripts/demo.mjs --host 127.0.0.1",
    "build:demo": "npm run typecheck && node scripts/demo.mjs build",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\" \"npm:news:worker\"",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "check:release": "node scripts/check-release.mjs",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "news:refresh": "tsx server/refresh.ts",
    "news:worker": "tsx server/worker.ts",
    "news:restore": "tsx server/restore.ts",
    "start:all": "concurrently -k \"npm:start\" \"npm:news:worker\"",
    "news:translate": "tsx server/translate.ts",
    "news:briefs": "tsx server/prepare-briefs.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "cheerio": "^1.2.0",
    "globe.gl": "^2.46.2",
    "lucide-react": "^1.46.0",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rss-parser": "^3.13.0",
    "three": "^0.186.0",
    "tsx": "^4.23.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
