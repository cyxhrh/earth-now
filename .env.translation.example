# Copy this file to .env.translation.local. Server only: never use VITE_ for secrets.
# Empty key = no model requests. Demo mode does not read this file.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Potential model requests per Beijing day; 0 pauses new model work.
# This is NOT a currency-denominated billing limit.
NEWS_DAILY_AI_ATTEMPTS=200
NEWS_POLL_MINUTES=30
NEWS_DATA_DIR=data
HOST=127.0.0.1
PORT=8787
# Optional external PostgreSQL; otherwise local PGlite is created automatically.
# DATABASE_URL=postgresql://user:password@localhost:5432/earth_now
